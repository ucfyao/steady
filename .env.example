# Copy to .env (pnpm bootstrap does this). Matches docker-compose.yml.
DATABASE_URL=postgres://steady:steady@localhost:5433/steady
API_PORT=4000
# Connections per process; use 1-3 on serverless (one pool per instance).
DB_POOL_MAX=10
LOG_LEVEL=info
# Spec 011: development tools (choose a new player's group). Never set in a deployment.
DEV_TOOLS=true
