# Copy to .env (pnpm bootstrap does this).

# Local Docker Postgres (docker-compose.yml): the default for development, tests and CI.
DATABASE_URL=postgres://steady:steady@localhost:5433/steady

# Or a Supabase project: use its session pooler URL (IPv4; the direct db.<ref>.supabase.co
# connection is IPv6-only) with the database password, and keep ?sslmode=no-verify.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify

API_PORT=4000
# Connections per process; use 1-3 on serverless (one pool per instance).
DB_POOL_MAX=10
LOG_LEVEL=info
